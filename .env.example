# ---- Application role: api | worker | all --------------------------------
APP_ROLE=all
HTTP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----------------------------------------------------------
# App connects as a restricted role; migrations run as the owner (see scripts/migrate.ts).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_APP_USER=wagering_app
POSTGRES_APP_PASSWORD=wagering_app_pwd
POSTGRES_OWNER_USER=wagering_owner
POSTGRES_OWNER_PASSWORD=wagering_owner_pwd
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# ---- SQS (MiniStack / LocalStack) ----------------------------------------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo

# ---- Worker tuning -------------------------------------------------------
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
CONSUMER_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_MS=500
PENDING_REFERENCE_POLL_MS=1000
PENDING_REFERENCE_MAX_ATTEMPTS=10
SHUTDOWN_DRAIN_MS=20000

# ---- Concurrency ---------------------------------------------------------
WALLET_LOCK_TIMEOUT_MS=5000
TX_MAX_RETRIES=5

# ---- Test-only fault injection (no-op in production) ---------------------
CHAOS_CRASH_AFTER_COMMIT=
